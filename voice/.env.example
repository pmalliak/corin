# Copy this file to voice/.env and fill it in. Never commit voice/.env.
# The root .gitignore already ignores every .env, so it stays out of git.

# --- required ---

# The same Discord application the Worker already uses. Developer Portal,
# your app, Bot, Reset Token. The Worker never needs this one; only the voice
# host does, because only the voice host logs in to the gateway.
# The app must be invited with the "bot" scope, not applications.commands
# alone, or there is no bot member and voice is impossible. `npm run check`
# says so plainly if it is wrong.
DISCORD_BOT_TOKEN=

# The private server. Right click the server icon with Developer Mode on.
DISCORD_GUILD_ID=

# A project key from platform.openai.com, restricted, model capabilities set
# to Write. Not a ChatGPT subscription, which is a separate product.
# Only the "echo" sink can run without it.
OPENAI_API_KEY=

# --- optional, with the defaults shown ---

# "coach" answers when named. "echo" plays you back to yourself and never
# calls OpenAI, which is how the audio path is diagnosed without spending.
#CORIN_SINK=coach

# Pin the coach to exactly one voice channel. Usually you want this empty and
# the decision made in Discord instead: the coach only enters channels where it
# has View Channel, Connect and Speak, so removing Connect from a channel keeps
# it out with no restart and no deploy.
#COACH_CHANNEL_ID=

# The mini model is a sixth of the price of the full one and the difference is
# hard to hear on two sentences of advice. Raise it when it stops being.
#COACH_MODEL=gpt-realtime-2.1
#COACH_VOICE=ash

# Every utterance is transcribed by this cheap model to decide whether the
# coach was addressed. That gate is what makes the coach affordable to leave
# running, since the expensive model then only ever hears questions.
#COACH_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Language handed to the transcriber. "el" measured strictly better than
# letting it guess for Greek speech with English League terms in it, and the
# English terms come back intact. Empty lets it guess.
#COACH_LANGUAGE=el

# Comma separated. Both scripts, because the name is said inside Greek
# sentences as often as English ones and speech to text writes what it hears.
# One mistaken letter still counts, so "Corim" and "Korin" wake the coach too.
#COACH_WAKE_WORDS=corin,κοριν,coach,κοουτς

# Seconds after an answer during which the same person may follow up without
# saying the name again. During this private line even short replies such as
# "ναι" and "και μετά;" are part of the conversation. Set 0 to require the
# wake word every single time.
#COACH_FOLLOW_UP_SECONDS=60

# This only applies when streaming is off. During the normal live line, the
# person who started the conversation can naturally use short follow-ups.
#COACH_FOLLOW_UP_MIN_WORDS=3

# Once the coach has answered you, your voice goes up live until the follow up
# window closes, and the model decides for itself when your sentence ended. That
# is what makes it feel like a phone rather than a walkie talkie. It never
# answers on its own: whether a sentence was meant for the coach is still
# decided here. Set off to keep every turn on the slower, cheaper path.
#COACH_STREAMING=on

# Vocabulary given to the transcriber before it listens. Without it, short
# Greek speech comes back transliterated into Latin and the name goes with it:
# "Κόριν, τι χτίζω τώρα;" was heard as "Χωρίμτη φτίζω τώρα". Empty means a
# default built from the wake words above, which is what you want.
#COACH_TRANSCRIBE_PROMPT=

# --- the game link ---

# Where the Worker lives, and permission to ask it what a match looks like right
# now. Both are needed; with either missing the coach still talks, it just
# cannot see anybody's game. The token must match the Worker secret of the same
# name, set with: npx wrangler secret put COACH_SERVICE_TOKEN
CORIN_WORKER_URL=https://corin.panos-malliakoudis.workers.dev
COACH_SERVICE_TOKEN=
