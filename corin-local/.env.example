# New, separate Discord application: "Corin Local".
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional. Leave empty to follow the permitted voice channel with the most people.
# CORIN_LOCAL_CHANNEL_ID=

# Voicemeeter's VBAN receiver normally listens on UDP 6980.
VM_HOST=127.0.0.1
VM_RECEIVE_PORT=6980

# Configure Voicemeeter's GPT_TO_CORIN VBAN OUT stream to send here.
LOCAL_RECEIVE_PORT=6981

# Keep these exact names in Voicemeeter's VBAN panel.
CORIN_TO_GPT_STREAM=CORIN_TO_GPT
GPT_TO_CORIN_STREAM=GPT_TO_CORIN
